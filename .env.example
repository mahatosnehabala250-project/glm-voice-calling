# ============================================
# VOICEAI SAAS - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to GitHub!

# ============================================
# DATABASE
# ============================================
# Local: DATABASE_URL=file:/home/z/my-project/db/custom.db
# Production Supabase: DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# GEMINI AI
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEMO_MODE=false

# ============================================
# VOBIZ SIP TRUNKING
# ============================================
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
VOBIZ_MOBILE_NO=+91XXXXXXXXXX
VOBIZ_CREDENTIAL_ID=your-credential-id

# ============================================
# WHATSAPP (MSG91 / Twilio)
# ============================================
WHATSAPP_API_KEY=
WHATSAPP_SENDER_ID=

# ============================================
# JWT AUTH
# ============================================
JWT_SECRET=change-this-in-production-to-a-strong-64-char-string

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VoiceAI
# Used by Caddy for SSL certificates — set to your domain in production
APP_DOMAIN=voiceai.yourdomain.com

# ============================================
# n8n WORKFLOW AUTOMATION
# ============================================
N8N_USERNAME=admin
N8N_PASSWORD=change-this-n8n-password
N8N_WEBHOOK_BASE=http://localhost:5678

# n8n Webhook URLs (auto-populated by n8n after workflow setup)
N8N_WEBHOOK_BOOKING=
N8N_WEBHOOK_CHECK_AVAILABILITY=
N8N_WEBHOOK_RESCHEDULE=
N8N_WEBHOOK_CANCEL=
N8N_WEBHOOK_ESCALATION=
N8N_WEBHOOK_CALL_SUMMARY=
N8N_WEBHOOK_TEST=

# ============================================
# DOCKER SERVICE URLs (for Docker Compose / Coolify)
# Only change these if you're using custom service names
# ============================================
VOBIZ_SERVICE_URL=http://vobiz-sip:3031
GEMINI_SERVICE_URL=http://gemini-ai:3032
WS_BRIDGE_SERVICE_URL=http://ws-bridge:3033
MAIN_APP_URL=http://voiceai-app:3000
